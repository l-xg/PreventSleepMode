// PreventSleepMode resources

#include <windows.h>

// 应用图标（由 gen_icon.py 生成）
101 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Anti-Sleep Assistant"
      VALUE "ProductName",     "PreventSleepMode"
      VALUE "FileVersion",     "1.0.0.0"
      VALUE "ProductVersion",  "1.0.0.0"
      VALUE "OriginalFilename","PreventSleepMode.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END

// RT_MANIFEST: enables Common Controls v6 + PerMonitorV2 DPI awareness
1 24 "app.manifest"
